    "border": "#2a2a33",
    "border-input": "#6c6c7c",
    "text": "#f5f5f7",
    "text-muted": "#a3a3b0",
    "accent": "#6350d8",
    "on-accent": "#ffffff",
    "danger": "#f87171",
    "success": "#4ade80",
    "warning": "#fbbf24"
  },
